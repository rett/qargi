#!/usr/bin/env bash
# qargi: the entry point. Each command is implemented by a script in lib/. The commands, verbs and options are
# described once, in lib/commands.py; that description drives `qargi help`, the manual page (man/qargi.1) and the
# bash completion (completions/qargi.bash). Add a flag to a script and describe it there; tests/test_help.py checks.
set -eu
root=$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)
lib=$root/lib

usage() { python3 -I "$lib/help.py" show >&2; exit 2; }
help="$lib/help.py"

area=${1:-}; [ -n "$area" ] || usage; shift
case $area in
  help|-h|--help) exec python3 -I "$help" show "$@";;
  __complete) exec python3 -I "$help" complete "$@";;
  __guard) exec python3 -I "$lib/guard.py" "$@";;
  version) cat "$root/VERSION"; exit 0;;
esac
# --json on any verb: the plan (or the output) as one JSON object (lib/jsonplan.py runs the call again without it). The marker says this
# call is that run; it is taken out here so that nothing the verb starts sees it. help, the guard, completion and the run-event hooks never wrap.
if [ -n "${QARGI_NO_JSON_WRAP:-}" ]; then unset QARGI_NO_JSON_WRAP
elif [ "$area" != hook ]; then
  for _a in "$@"; do
    [ "$_a" != --json ] || exec python3 -I "$lib/jsonplan.py" "$area" "$@"
  done
fi
# qargi COMMAND --help and qargi COMMAND VERB --help
case ${1:-} in -h|--help) exec python3 -I "$help" show "$area";; esac
case ${2:-} in -h|--help) exec python3 -I "$help" show "$area" "${1:-}";; esac
# The run-event hooks (qargi hook tool-use ...) never go through resolve and never fail: a hook must not block an agent.
case $area:${1:-} in
  hook:subagent-start|hook:subagent-stop|hook:tool-use|hook:tool-failure|hook:notification|hook:stop-failure|hook:pre-compact)
    "$lib/hook.sh" "$@" || true; exit 0;;
esac
# The preamble, one python process (lib/help.py preamble): a dev run says so on stderr, once per command (lib/paths.py);
# what the current directory implies is filled in (a missing PROJECT, a role used as an instance; lib/help.py resolve);
# and the project's cloud binding is read (qargi cloud). It prints project, profile, workspace id and the resolved
# arguments, NUL-separated; nothing when resolve refused (its message is on stderr). help.py is imported, not run as a
# script, so its compiled form is reused (python compiles a script on every run, a cache only an imported module gets).
mapfile -d '' -t _pre < <(python3 -I -c 'import sys; sys.path.insert(0, sys.argv[1]); import help; sys.exit(help.main(["preamble"] + sys.argv[2:]))' "$lib" "$area" "$@")
[ "${#_pre[@]}" -ge 4 ] || exit 2
area=${_pre[3]}; set -- "${_pre[@]:4}"
# With a binding, ant runs under the project's profile for this command, and lib.sh checks the workspace before a cloud
# call. A command that is about no project, or a project without a binding, is left as it is.
if [ -n "${_pre[1]}" ]; then
  if [ -n "${ANTHROPIC_PROFILE:-}" ] && [ "$ANTHROPIC_PROFILE" != "${_pre[1]}" ]; then
    echo "qargi: project ${_pre[0]} uses ant profile ${_pre[1]} (qargi cloud show), but ANTHROPIC_PROFILE is $ANTHROPIC_PROFILE; unset it or change the binding" >&2; exit 1
  fi
  export ANTHROPIC_PROFILE=${_pre[1]} QARGI_CLOUD_WORKSPACE=${_pre[2]} QARGI_CLOUD_PROJECT=${_pre[0]}
fi
case $area in
  cloud) exec python3 -I "$lib/cloud.py" "$@";;
  project) exec "$lib/project.sh" "$@";;
  instances) exec "$lib/registry.sh" "$@";;
  provision) exec "$lib/provision.sh" "$@";;
  review) case ${1:-} in check|apply) exec "$lib/review.sh" "$@";; *) usage;; esac;;
  skill|tool) exec "$lib/packs.sh" "$area" "$@";;
  packs) exec "$lib/packs.sh" packs "$@";;
  credential) exec "$lib/cred.sh" "$@";;
  local) exec "$lib/local.sh" "$@";;
  agent) exec "$lib/agent.sh" "$@";;
  role) exec "$lib/role.sh" "$@";;
  feature) exec "$lib/feature.sh" "$@";;
  marshal) exec "$lib/marshal.sh" "$@";;
  release) exec "$lib/release.sh" "$@";;
  branch) exec "$lib/branch.sh" "$@";;
  changelog) exec "$lib/changelog.sh" "$@";;
  upstream) exec "$lib/upstream.sh" "$@";;
  ref) exec "$lib/ref.sh" "$@";;
  methodology) exec python3 -I "$lib/methodology.py" "$@";;
  canon) exec "$lib/canon.sh" "$@";;
  memory) exec "$lib/memory.sh" "$@";;
  start|send|status|stop|mark|close|track) exec "$lib/session.sh" "$area" "$@";;
  report) exec python3 -I "$lib/report.py" "$@";;
  noticed) exec python3 -I "$lib/noticed.py" "$@";;
  provider) exec python3 -I "$lib/provider.py" "$@";;
  env) exec python3 -I "$lib/env.py" "$@";;
  upgrade) exec "$lib/upgrade.sh" "$@";;
  watch) exec "$lib/watch.sh" "$@";;
  collect) exec "$lib/collect.sh" "$@";;
  team) exec "$lib/team.sh" "$@";;
  lead) exec "$lib/lead.sh" "$@";;
  hook) exec "$lib/hook.sh" "$@";;
  supervise) exec "$lib/supervise.sh" "$@";;
  discover) exec python3 -I "$lib/discover.py" "$@";;
  export|import) exec python3 -I "$lib/transfer.py" "$area" "$@";;
  *) echo "qargi: unknown command '$area'. Try: qargi help" >&2; exit 2;;
esac
