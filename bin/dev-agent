#!/usr/bin/env bash
# dev-agent: one entry point for the helper scripts behind the dev-* skills.
#
#   dev-agent project template|init|show|list|validate ...      (skill: dev-project)
#   dev-agent instances init|list|show|remove|normalize ...   (skill: dev-instances)
#   dev-agent provision plan|apply|add-reference ...           (skill: dev-provision)
#   dev-agent memory seed|seed-reference|lint ...              (skill: dev-memory)
#   dev-agent canon check|plan|apply|import|promote PROJECT ... (skill: dev-memory)
#   dev-agent skill|tool new|import|list|show|link|unlink|enable|disable|effective|check|remove ...   (skill: dev-packs)
#   dev-agent packs render|apply ...                          (skill: dev-packs)
#   dev-agent credential check PROJECT [--allow-write-token]   (skill: dev-project)
#   dev-agent local prepare|verify ...                         (skill: dev-task)
#   dev-agent start|send|status|stop|mark|close ...            (skill: dev-task)
#   dev-agent watch SID [MAX_SECONDS]
#   dev-agent collect SID DIR
#   dev-agent version
set -eu
root=$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)
lib=$root/lib

usage() { sed -n '2,16p' "$0" | sed 's/^# \{0,1\}//' >&2; exit 2; }

area=${1:-}; [ -n "$area" ] || usage; shift
case $area in
  project) exec "$lib/project.sh" "$@";;
  instances) exec "$lib/registry.sh" "$@";;
  provision) exec "$lib/provision.sh" "$@";;
  skill|tool) exec "$lib/packs.sh" "$area" "$@";;
  packs) exec "$lib/packs.sh" packs "$@";;
  credential) exec "$lib/cred.sh" "$@";;
  local) exec "$lib/local.sh" "$@";;
  canon) exec "$lib/canon.sh" "$@";;
  memory) exec "$lib/memory.sh" "$@";;
  start|send|status|stop|mark|close|track) exec "$lib/session.sh" "$area" "$@";;
  watch) exec "$lib/watch.sh" "$@";;
  collect) exec "$lib/collect.sh" "$@";;
  version) cat "$root/VERSION";;
  *) usage;;
esac
