#!/usr/bin/env python3
"""The adapter of the schema 1 descriptor lib/providers/claude.json: a router, kept while that file stays.

claude.json served both surfaces with one adapter. The two surfaces are now two runtimes, each with its own adapter
(lib/providers/claude-code/adapter for the local one, lib/providers/claude-platform/adapter for the cloud one), but agent.sh and
session.sh still reach the adapter through the `adapter` field of claude.json. This file passes the request to the runtime that
serves it and gives back its exit status, its stdout and its stderr unchanged:
  start-session                  -> claude-platform
  resolve with surface cloud     -> claude-platform
  every other verb               -> claude-code (a request it cannot read is its bad request, exit 1)
It holds no logic of its own. It goes when claude.json goes, once its readers use the loader and name a runtime.

Stdlib only. It runs isolated (python3 -I) and finds its neighbours relative to itself."""
import os
import sys

if not sys.flags.isolated:                       # run directly or through the shebang: re-run isolated, stdin and arguments kept
    os.execv(sys.executable, [sys.executable, "-I", os.path.abspath(__file__)] + sys.argv[1:])

import json  # noqa: E402
import subprocess  # noqa: E402

HERE = os.path.dirname(os.path.realpath(__file__))
PROVIDERS = os.path.dirname(HERE)


def target(verb, raw):
    cloud = verb == "start-session"
    if verb == "resolve":
        try:
            req = json.loads(raw)
            cloud = isinstance(req, dict) and req.get("surface") == "cloud"
        except ValueError:
            pass
    return os.path.join(PROVIDERS, "claude-platform" if cloud else "claude-code", "adapter")


def main(argv):
    raw = sys.stdin.read()
    verb = argv[0] if argv else ""
    r = subprocess.run([sys.executable, "-I", target(verb, raw)] + argv, input=raw, capture_output=True, text=True)
    sys.stdout.write(r.stdout)
    sys.stderr.write(r.stderr)
    return r.returncode


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
