#compdef qargi
# zsh completion for qargi. Install: install.sh --user puts this file in ~/.local/share/zsh/site-functions;
# that directory must be in $fpath before compinit runs (add to ~/.zshrc):
#   fpath=(~/.local/share/zsh/site-functions $fpath)
# The candidates come from `qargi __complete`, the same description that drives the help and the man page.
local -a out items
local line c d
out=("${(@f)$(qargi __complete --described "${(@)words[2,CURRENT]}" 2>/dev/null)}")
if [[ ${out[1]} == '@file' ]]; then _files; return; fi
if [[ ${out[1]} == '@dir' ]]; then _files -/; return; fi
for line in "${out[@]}"; do
  [[ -n $line ]] || continue
  c=${line%%$'\t'*}
  d=; [[ $line == *$'\t'* ]] && d=${line#*$'\t'}
  items+=("${c//:/\\:}:${d}")
done
(( ${#items} )) && _describe -t qargi-values 'qargi' items
