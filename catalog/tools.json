   "install": {
    "name": "github-read",
    "url": "https://api.githubcopilot.com/mcp/",
    "tools": {
     "get_file_contents": "always_allow",
     "get_commit": "always_allow",
     "list_commits": "always_allow",
     "list_branches": "always_allow",
     "list_tags": "always_allow",
     "get_tag": "always_allow",
     "get_latest_release": "always_allow",
     "get_release_by_tag": "always_allow",
     "list_pull_requests": "always_allow"
    },
    "vault_ids": []
   },
   "scope_hint": "user-role",
   "verify": "allowlist = the read tools of provision/templates/github-lead.json that the server really exposes (four allowlisted there were not among its 14 tools); the vault credential is yours to attach"
