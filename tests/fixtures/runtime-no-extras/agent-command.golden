--- agent for build
worker gpt-6.1-terra high build
exit 0
--- agent for build --json
{
  "role": "build",
  "class": "write",
  "profile": "build",
  "mode": "command",
  "profile_source": "shipped",
  "base": "worker",
  "member": "worker",
  "tier": "balanced",
  "model": null,
  "model_id": "gpt-6.1-terra",
  "effort": "high",
  "opt_in": false,
  "purpose": "changes the code of a project, with its tests and documentation, in a clone of its own"
}
exit 0
--- agent for review
reviewer gpt-6.1-sol high review
exit 0
--- agent for review --json
{
  "role": "review",
  "class": "read-only",
  "profile": "review",
  "mode": "command",
  "profile_source": "shipped",
  "base": "reviewer",
  "member": "reviewer",
  "tier": "deep",
  "model": null,
  "model_id": "gpt-6.1-sol",
  "effort": "high",
  "opt_in": false,
  "purpose": "judges a change someone else made and writes a report; read-only"
}
exit 0
--- agent for --profile worker-fast
worker gpt-6-luna low worker-fast
exit 0
--- agent for --profile reviewer-deep
reviewer gpt-6.1-sol high reviewer-deep
exit 0
--- agent models
bases (logical, by guard class; command dispatch needs no member registration)
  worker     write      build,write,test
  reviewer   read-only  review
profiles (provider: codex, command mode; base, selected model id or alias, requested effort level, source)
  lead        -         -                      default  shipped  never dispatched
  build       worker    gpt-6.1-terra          high     shipped  
  write       worker    gpt-6.1-terra          medium   shipped  
  test        worker    gpt-6.1-terra          low      shipped  
  review      reviewer  gpt-6.1-sol            high     shipped  
  auditor     reviewer  gpt-6-luna             low      shipped  
  advisor     reviewer  gpt-6.1-sol            high     shipped  
  researcher  reviewer  gpt-6-astra            high     shipped  opt-in
  worker-fast worker    gpt-6-luna             low      project  
  reviewer-deep reviewer  gpt-6.1-sol            high     project  
  offer frontier (gpt-6-astra) for a hard task: only when asked
exit 0
