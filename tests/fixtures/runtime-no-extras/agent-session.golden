--- agent for build
worker sonnet high build
exit 0
--- agent for build --json
{
  "role": "build",
  "class": "write",
  "profile": "build",
  "profile_source": "project",
  "base": "worker",
  "member": "worker",
  "tier": "balanced",
  "model": "sonnet",
  "model_id": "claude-sonnet-5-5",
  "effort": "high",
  "opt_in": false,
  "purpose": "changes the code of a project, with its tests and documentation, in a clone of its own"
}
exit 0
--- agent for review
reviewer opus high review
exit 0
--- agent for review --json
{
  "role": "review",
  "class": "read-only",
  "profile": "review",
  "profile_source": "project",
  "base": "reviewer",
  "member": "reviewer",
  "tier": "deep",
  "model": "opus",
  "model_id": "claude-opus-5-5",
  "effort": "high",
  "opt_in": false,
  "purpose": "judges a change someone else made and writes a report; read-only"
}
exit 0
--- agent for --profile worker-fast
worker haiku low worker-fast
exit 0
--- agent for --profile reviewer-deep
reviewer opus high reviewer-deep
exit 0
--- agent models
bases (one member each, by guard class)
  worker     write      build,write,test   registered      
  reviewer   read-only  review             registered      
profiles (provider: claude-code; tier -> alias -> model/effort; a role of yours uses its class: write -> build, read-only -> review)
  lead        -         balanced -> sonnet -> claude-sonnet-5-5/medium       shipped    never dispatched 
  build       worker    balanced -> sonnet -> claude-sonnet-5-5/high         project (roles) 
  write       worker    balanced -> sonnet -> claude-sonnet-5-5/medium       shipped    
  test        worker    balanced -> sonnet -> claude-sonnet-5-5/low          shipped    
  review      reviewer  deep -> opus -> claude-opus-5-5/high                 project (roles) 
  auditor     reviewer  fast -> haiku -> claude-haiku-5-5/low                shipped    
  advisor     reviewer  deep -> opus -> claude-opus-5-5/high                 shipped    
  researcher  reviewer  frontier -> fable -> claude-fable-5-2/high           shipped    opt-in 
  worker-fast worker    fast -> haiku -> claude-haiku-5-5/low                project    
  reviewer-deep reviewer  deep -> opus -> claude-opus-5-5/high                 project    
  offer frontier (claude-fable-5-2) for a hard task: only when asked
members
   worker      build,write,test       claude-sonnet-5-5/high       
   reviewer    review                 claude-opus-5-5/high         
exit 0
